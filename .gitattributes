* text=auto
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf
*.pdf binary
*.png binary
# Matplotlib SVG paths intentionally contain line-ending spaces.
*.svg text eol=lf whitespace=-blank-at-eol
